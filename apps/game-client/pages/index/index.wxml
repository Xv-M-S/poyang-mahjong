<view wx:if="{{screen === 'lobby'}}" class="lobby">
  <view class="brand-tile">鄱</view>
  <text class="brand-title">鄱阳麻将</text>
  <text class="brand-subtitle">四人本地摸打演示</text>
  <button class="primary-button" bindtap="startGame">开始对局</button>
  <view class="feature-row">
    <text>136 张标准牌墙</text>
    <text>自动洗牌发牌</text>
    <text>电脑玩家轮转</text>
  </view>
  <text class="lobby-note">当前版本先验证完整摸打流程，吃、碰、杠、胡和联网房间将在后续接入。</text>
</view>

<view wx:else class="table-page">
  <view class="table-header">
    <view>
      <text class="round-label">第 {{round}} 局</text>
      <text class="wall-label">牌墙 {{wallCount}} 张</text>
    </view>
    <view class="header-actions">
      <button class="mini-button" bindtap="startGame">重开</button>
      <button class="mini-button ghost" bindtap="backToLobby">退出</button>
    </view>
  </view>

  <view class="mahjong-table">
    <view wx:for="{{opponents}}" wx:key="seat" class="opponent opponent-{{item.position}} {{item.active ? 'active' : ''}}">
      <view class="avatar">{{item.initial}}</view>
      <view class="opponent-meta">
        <text>{{item.name}}</text>
        <text class="tile-count">{{item.count}} 张 · {{item.meldCount}} 组</text>
      </view>
    </view>

    <view class="center-panel">
      <view class="wind-disc">
        <text class="wind-main">东</text>
        <text class="wind-sub">{{currentName}}行动</text>
      </view>
      <text class="turn-message">{{message}}</text>
    </view>

    <view class="discard-area discard-top">
      <view wx:for="{{discards[2]}}" wx:key="id" class="discard-tile suit-{{item.suitClass}}">
        <text>{{item.symbol}}</text><text class="discard-unit">{{item.unit}}</text>
      </view>
    </view>
    <view class="discard-area discard-left">
      <view wx:for="{{discards[3]}}" wx:key="id" class="discard-tile suit-{{item.suitClass}}">
        <text>{{item.symbol}}</text><text class="discard-unit">{{item.unit}}</text>
      </view>
    </view>
    <view class="discard-area discard-right">
      <view wx:for="{{discards[1]}}" wx:key="id" class="discard-tile suit-{{item.suitClass}}">
        <text>{{item.symbol}}</text><text class="discard-unit">{{item.unit}}</text>
      </view>
    </view>
    <view class="discard-area discard-bottom">
      <view wx:for="{{discards[0]}}" wx:key="id" class="discard-tile suit-{{item.suitClass}}">
        <text>{{item.symbol}}</text><text class="discard-unit">{{item.unit}}</text>
      </view>
    </view>
  </view>

  <view class="player-panel {{currentSeat === 0 ? 'my-turn' : ''}}">
    <scroll-view wx:if="{{playerMelds.length}}" class="meld-scroll" scroll-x show-scrollbar="false">
      <view class="meld-row">
        <view wx:for="{{playerMelds}}" wx:key="index" class="meld-group">
          <text class="meld-label">{{item.label}}</text>
          <view class="meld-tiles">
            <view wx:for="{{item.tiles}}" wx:for-item="meldTile" wx:key="id" class="meld-tile suit-{{meldTile.suitClass}}">
              <text>{{meldTile.symbol}}</text><text class="meld-unit">{{meldTile.unit}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{availableActions.length}}" class="action-bar">
      <button wx:for="{{availableActions}}" wx:key="key" class="action-button action-{{item.actionClass}}" data-action="{{item.action}}" data-source="{{item.source}}" data-choice-index="{{item.choiceIndex}}" data-kind="{{item.kind}}" bindtap="chooseAction">
        <text>{{item.label}}</text>
        <text wx:if="{{item.detail}}" class="action-detail">{{item.detail}}</text>
      </button>
      <button wx:if="{{awaitingReaction}}" class="action-button action-pass" bindtap="passReaction">过</button>
    </view>

    <view class="player-status">
      <text>{{playerStatusText}}</text>
      <button class="discard-button" disabled="{{currentSeat !== 0 || phase !== 'DISCARD' || selectedId === null || finished}}" bindtap="discardSelected">出牌</button>
    </view>
    <scroll-view class="hand-scroll" scroll-x enhanced show-scrollbar="false">
      <view class="hand-row">
        <view wx:for="{{hand}}" wx:key="id" data-id="{{item.id}}" bindtap="selectTile" class="mahjong-tile suit-{{item.suitClass}} {{item.selected ? 'selected' : ''}}">
          <text class="tile-symbol">{{item.symbol}}</text>
          <text class="tile-unit">{{item.unit}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{finished}}" class="result-mask">
    <view class="result-card">
      <text class="result-title">{{resultTitle}}</text>
      <text wx:if="{{winPatternText}}" class="result-patterns">{{winPatternText}}</text>
      <text class="result-message">{{message}}</text>
      <button class="primary-button compact" bindtap="startGame">再来一局</button>
    </view>
  </view>
</view>

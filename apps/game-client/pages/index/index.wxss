.lobby {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 72rpx 48rpx;
  background: radial-gradient(circle at 50% 30%, #176b50 0%, #083c31 50%, #052c25 100%);
}

.brand-tile {
  width: 132rpx;
  height: 164rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #fff9e7;
  color: #b82e27;
  font-size: 70rpx;
  font-weight: 800;
  box-shadow: inset 0 -12rpx 0 #d9cfaa, 0 18rpx 42rpx rgba(0, 0, 0, 0.28);
}

.brand-title {
  margin-top: 44rpx;
  color: #f6d788;
  font-size: 68rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
}

.brand-subtitle {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 30rpx;
}

.primary-button {
  width: 420rpx;
  margin-top: 62rpx;
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f5d278, #dca942);
  color: #173b31;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 28rpx rgba(0, 0, 0, 0.22);
}

.primary-button::after,
.mini-button::after,
.discard-button::after {
  border: 0;
}

.primary-button.compact {
  width: 300rpx;
  margin-top: 40rpx;
}

.feature-row {
  display: flex;
  gap: 12rpx;
  margin-top: 44rpx;
  color: rgba(255, 255, 255, 0.64);
  font-size: 22rpx;
}

.feature-row text {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
}

.lobby-note {
  max-width: 590rpx;
  margin-top: 34rpx;
  color: rgba(255, 255, 255, 0.48);
  font-size: 23rpx;
  line-height: 1.7;
  text-align: center;
}

.table-page {
  min-height: 100vh;
  background: #082f27;
  overflow: hidden;
}

.table-header {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 26rpx;
  background: #0b4134;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.round-label,
.wall-label {
  display: block;
}

.round-label {
  color: #f6d788;
  font-size: 27rpx;
  font-weight: 700;
}

.wall-label {
  margin-top: 3rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 20rpx;
}

.header-actions {
  display: flex;
  gap: 12rpx;
}

.mini-button {
  margin: 0;
  padding: 0 24rpx;
  line-height: 54rpx;
  border-radius: 999rpx;
  background: #d9b85c;
  color: #16382f;
  font-size: 22rpx;
}

.mini-button.ghost {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.75);
}

.mahjong-table {
  position: relative;
  height: calc(100vh - 540rpx);
  min-height: 500rpx;
  margin: 18rpx;
  border: 2rpx solid rgba(215, 183, 91, 0.32);
  border-radius: 34rpx;
  background: radial-gradient(circle, #176d50 0%, #10523f 55%, #0a4235 100%);
  box-shadow: inset 0 0 80rpx rgba(0, 0, 0, 0.22);
}

.opponent {
  position: absolute;
  z-index: 4;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 12rpx;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.2);
  color: rgba(255, 255, 255, 0.82);
}

.opponent.active {
  border-color: #f6d788;
  box-shadow: 0 0 24rpx rgba(246, 215, 136, 0.32);
}

.opponent-top { top: 16rpx; left: 50%; transform: translateX(-50%); }
.opponent-left { left: 14rpx; top: 43%; }
.opponent-right { right: 14rpx; top: 43%; }

.avatar {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #d8b65b;
  color: #173b31;
  font-size: 22rpx;
  font-weight: 700;
}

.opponent-meta text { display: block; font-size: 21rpx; }
.opponent-meta .tile-count { color: rgba(255, 255, 255, 0.45); font-size: 18rpx; }

.center-panel {
  position: absolute;
  left: 50%;
  top: 48%;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translate(-50%, -50%);
}

.wind-disc {
  width: 150rpx;
  height: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(246, 215, 136, 0.55);
  border-radius: 50%;
  background: rgba(4, 38, 31, 0.7);
  color: #f6d788;
}

.wind-main { font-size: 54rpx; font-weight: 800; line-height: 1; }
.wind-sub { margin-top: 8rpx; font-size: 18rpx; color: rgba(255, 255, 255, 0.68); }
.turn-message { width: 300rpx; margin-top: 18rpx; color: rgba(255, 255, 255, 0.62); font-size: 20rpx; text-align: center; }

.discard-area {
  position: absolute;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  width: 250rpx;
  max-height: 160rpx;
  overflow: hidden;
}

.discard-top { top: 94rpx; left: 50%; transform: translateX(-50%); justify-content: center; }
.discard-bottom { bottom: 20rpx; left: 50%; transform: translateX(-50%); justify-content: center; }
.discard-left { left: 72rpx; top: 51%; transform: translateY(-50%); }
.discard-right { right: 72rpx; top: 51%; transform: translateY(-50%); justify-content: flex-end; }

.discard-tile {
  width: 36rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4rpx;
  background: #f8f3df;
  color: #223c36;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: inset 0 -4rpx #d4cba9;
}

.discard-unit { font-size: 12rpx; margin-left: 1rpx; }

.player-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 410rpx;
  padding: 12rpx 0 16rpx;
  background: linear-gradient(180deg, #0b3f34, #062a24);
  border-top: 2rpx solid rgba(255, 255, 255, 0.08);
}

.player-panel.my-turn { border-top-color: rgba(246, 215, 136, 0.72); }

.player-status {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
}

.discard-button {
  width: 140rpx;
  margin: 0;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #d8b65b;
  color: #173b31;
  font-size: 25rpx;
  font-weight: 700;
}

.discard-button[disabled] { background: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.28); }
.hand-scroll { width: 100%; height: 166rpx; white-space: nowrap; }
.hand-row { display: inline-flex; align-items: flex-end; min-width: 100%; height: 160rpx; padding: 18rpx 18rpx 4rpx; }

.mahjong-tile {
  flex: 0 0 50rpx;
  width: 50rpx;
  height: 116rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 3rpx;
  border-radius: 7rpx 7rpx 5rpx 5rpx;
  background: #fff9e7;
  color: #1d3e35;
  transform: translateY(0);
  box-shadow: inset 0 -8rpx 0 #d9cfaa, 0 7rpx 10rpx rgba(0, 0, 0, 0.24);
  transition: transform 0.12s ease;
}

.mahjong-tile.selected {
  transform: translateY(-20rpx);
  outline: 4rpx solid #f6d788;
}

.tile-symbol { font-size: 38rpx; font-weight: 800; line-height: 1; }
.tile-unit { margin-top: 5rpx; font-size: 20rpx; font-weight: 700; }
.suit-wan { color: #bd3029; }
.suit-tong { color: #176f56; }
.suit-tiao { color: #245f9e; }
.suit-honor { color: #b52d27; }

.result-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(2, 20, 17, 0.75);
}

.result-card {
  width: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 58rpx 42rpx;
  border: 2rpx solid rgba(246, 215, 136, 0.45);
  border-radius: 30rpx;
  background: #124c3e;
}

.result-title { color: #f6d788; font-size: 48rpx; font-weight: 800; }
.result-message { margin-top: 22rpx; color: rgba(255, 255, 255, 0.72); font-size: 26rpx; }


.meld-scroll {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  white-space: nowrap;
}

.meld-row {
  display: inline-flex;
  gap: 14rpx;
  height: 72rpx;
}

.meld-group {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 5rpx 10rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.07);
}

.meld-label {
  color: #f6d788;
  font-size: 19rpx;
}

.meld-tiles {
  display: flex;
  gap: 2rpx;
}

.meld-tile {
  width: 34rpx;
  height: 54rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 4rpx;
  background: #fff9e7;
  font-size: 21rpx;
  font-weight: 700;
  box-shadow: inset 0 -4rpx 0 #d9cfaa;
}

.meld-unit {
  font-size: 12rpx;
}

.action-bar {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 5rpx 18rpx;
  background: rgba(0, 0, 0, 0.12);
}

.action-button {
  min-width: 92rpx;
  height: 62rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 4rpx 16rpx;
  border: 0;
  border-radius: 14rpx;
  background: #d9b85c;
  color: #173b31;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.05;
  box-shadow: 0 7rpx 16rpx rgba(0, 0, 0, 0.2);
}

.action-button::after {
  border: 0;
}

.action-detail {
  max-width: 180rpx;
  margin-top: 4rpx;
  overflow: hidden;
  color: rgba(23, 59, 49, 0.72);
  font-size: 16rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-hu {
  background: linear-gradient(135deg, #ef6559, #c6372d);
  color: #ffffff;
}

.action-gang {
  background: linear-gradient(135deg, #efcf74, #d4a13c);
}

.action-peng,
.action-chi {
  background: linear-gradient(135deg, #f0e0aa, #d8b85c);
}

.action-pass {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.72);
}

.result-patterns {
  margin-top: 20rpx;
  color: #f6d788;
  font-size: 28rpx;
  font-weight: 700;
}


.player-panel {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}


.score-strip {
  display: flex;
  gap: 6rpx;
}

.score-chip {
  min-width: 60rpx;
  padding: 5rpx 7rpx;
  border-radius: 9rpx;
  background: rgba(255, 255, 255, 0.07);
  color: rgba(255, 255, 255, 0.62);
  font-size: 16rpx;
  text-align: center;
}

.score-chip text {
  display: block;
}

.score-chip.dealer {
  background: rgba(246, 215, 136, 0.18);
  color: #f6d788;
}

.score-value {
  margin-top: 2rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.result-card {
  max-height: 82vh;
}

.demo-rule-badge {
  align-self: center;
  margin-top: 14rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(246, 215, 136, 0.12);
  color: rgba(246, 215, 136, 0.8);
  font-size: 19rpx;
}

.dealer-result {
  align-self: center;
  margin-top: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #f6d788;
  font-size: 23rpx;
}

.settlement-table {
  width: 100%;
  margin-top: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
}

.settlement-head,
.settlement-line {
  display: flex;
  align-items: center;
  min-height: 54rpx;
  padding: 0 18rpx;
  text-align: center;
}

.settlement-head {
  background: rgba(0, 0, 0, 0.18);
  color: rgba(255, 255, 255, 0.48);
  font-size: 19rpx;
}

.settlement-line {
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
}

.delta {
  font-weight: 800;
}

.delta.positive {
  color: #65dfa0;
}

.delta.negative {
  color: #ff8178;
}

.kong-score-note {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.4);
  font-size: 18rpx;
  text-align: center;
}

.ranking-list {
  width: 100%;
  margin-top: 28rpx;
}

.ranking-title {
  display: block;
  margin-bottom: 12rpx;
  color: #f6d788;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.ranking-line {
  display: flex;
  padding: 14rpx 18rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  text-align: center;
}

.ranking-line.champion {
  border-radius: 12rpx;
  background: rgba(246, 215, 136, 0.14);
  color: #f6d788;
  font-weight: 700;
}

.result-exit {
  width: 260rpx;
  margin: 18rpx auto 10rpx;
  border: 0;
  background: transparent;
  color: rgba(255, 255, 255, 0.5);
  font-size: 23rpx;
}

.result-exit::after {
  border: 0;
}


.settlement-head text,
.settlement-line text,
.ranking-line text {
  width: 33.333%;
}

.online-entry{width:420rpx;margin-top:20rpx;border:1rpx solid rgba(246,215,136,.55);border-radius:999rpx;background:rgba(255,255,255,.06);color:#f6d788;font-size:30rpx}.online-entry::after{border:0}

/* classic-mahjong-theme */
.lobby {
  position: relative;
  background: radial-gradient(circle at 50% 24%, rgba(196,151,62,.2), transparent 30%), repeating-linear-gradient(45deg,rgba(255,255,255,.018) 0 2rpx,transparent 2rpx 16rpx), linear-gradient(155deg,#124b39,#092f27 56%,#061f1b);
  box-shadow: inset 0 0 120rpx rgba(0,0,0,.35);
}
.lobby::before,.lobby::after { content:""; position:absolute; left:34rpx; right:34rpx; height:8rpx; border:1rpx solid rgba(218,174,82,.5); border-left-width:8rpx; border-right-width:8rpx; }
.lobby::before { top:42rpx; }
.lobby::after { bottom:42rpx; }
.brand-tile { border:5rpx solid #e7d8b4; border-radius:14rpx; background:linear-gradient(145deg,#fffdf0,#efe4c5 72%,#d2bd88); color:#a8221e; box-shadow:inset 0 -15rpx 0 #c9b47f,0 18rpx 0 #3d8465,0 28rpx 36rpx rgba(0,0,0,.4); }
.brand-title { color:#eed28a; font-family:"STKaiti","KaiTi",serif; text-shadow:0 4rpx #6c251c; letter-spacing:12rpx; }
.primary-button { border:2rpx solid #f1d18a; border-radius:12rpx; background:linear-gradient(#b94435,#87251f); color:#fff2ca; box-shadow:0 9rpx 0 #4f1714,0 16rpx 24rpx rgba(0,0,0,.3); }
.online-entry,.secondary-button { border:2rpx solid rgba(224,185,98,.7); border-radius:12rpx; background:linear-gradient(rgba(255,248,220,.1),rgba(0,0,0,.12)); color:#ead08a; }
.feature-row text { border:1rpx solid rgba(224,185,98,.25); border-radius:6rpx; background:rgba(4,28,23,.5); color:#c8b78f; }
.table-page { background:linear-gradient(90deg,#3a1d13 0,#6f3822 18rpx,#102f26 18rpx,#102f26 calc(100% - 18rpx),#6f3822 calc(100% - 18rpx),#3a1d13 100%); }
.table-header { background:linear-gradient(#512719,#2e1711); border-bottom:5rpx solid #a66b34; box-shadow:0 7rpx 18rpx rgba(0,0,0,.38); }
.round-label { color:#f0d28b; text-shadow:0 2rpx #30130d; }
.score-chip { border:1rpx solid rgba(228,190,112,.22); border-radius:4rpx; background:rgba(20,8,5,.35); }
.score-chip.dealer { border-color:#d8ad55; background:#762d21; }
.mahjong-table { margin:22rpx 26rpx; border:10rpx solid #7c4626; border-radius:18rpx; background:radial-gradient(circle at 50% 48%,rgba(35,126,91,.72),transparent 45%),repeating-linear-gradient(135deg,rgba(255,255,255,.012) 0 2rpx,transparent 2rpx 8rpx),#0d4a38; box-shadow:inset 0 0 0 3rpx #b0793b,inset 0 0 100rpx rgba(0,0,0,.35),0 12rpx 28rpx rgba(0,0,0,.42); }
.opponent { border-radius:8rpx; border-color:rgba(218,176,86,.25); background:linear-gradient(rgba(40,20,13,.9),rgba(17,34,27,.9)); }
.opponent.active { border-color:#edc96f; background:linear-gradient(#713023,#351c16); }
.avatar { border:2rpx solid #f0d28b; border-radius:7rpx; background:linear-gradient(145deg,#f0d999,#b8873d); color:#5c1e19; }
.wind-disc { border:7rpx double #c79a4a; border-radius:12rpx; background:linear-gradient(145deg,rgba(54,27,17,.94),rgba(7,47,37,.94)); box-shadow:0 10rpx 24rpx rgba(0,0,0,.35); }
.wind-main { color:#edcf82; text-shadow:0 3rpx #6d211b; }
.discard-tile,.meld-tile,.mahjong-tile { overflow:hidden; border:1rpx solid #c9b783; background:linear-gradient(145deg,#fffdf2,#f2e9cd 68%,#d6c28f); box-shadow:inset 0 -6rpx 0 #c9b77f,0 5rpx 7rpx rgba(0,0,0,.32); }
.mahjong-tile { box-shadow:inset 0 -9rpx 0 #c9b77f,0 9rpx 0 #397c60,0 14rpx 13rpx rgba(0,0,0,.38); }
.mahjong-tile.selected { transform:translateY(-24rpx); outline:4rpx solid #f0c85e; box-shadow:inset 0 -9rpx 0 #c9b77f,0 9rpx 0 #a22f25,0 16rpx 22rpx rgba(0,0,0,.45); }
.tile-face { width:100%; height:100%; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.tile-art { display:block; width:100%; height:100%; }
.discard-tile .tile-art,.meld-tile .tile-art { width:108%; height:108%; }
.player-panel { background:linear-gradient(#502719 0,#2e1812 16rpx,#0a3028 16rpx,#061f1b 100%); border-top:4rpx solid #a86b34; box-shadow:0 -12rpx 28rpx rgba(0,0,0,.35); }
.player-panel.my-turn { border-top-color:#efcd76; }
.action-bar { background:rgba(31,14,9,.52); border-top:1rpx solid rgba(231,196,121,.18); border-bottom:1rpx solid rgba(231,196,121,.18); }
.action-button,.discard-button { border:2rpx solid #e7c875; border-radius:7rpx; background:linear-gradient(#b94435,#84261f); color:#fff0c4; box-shadow:0 5rpx 0 #4e1713; }
.action-gang,.action-peng,.action-chi { background:linear-gradient(#e1c071,#a97831); color:#3e2115; }
.result-card { border:9rpx double #d0a856; border-radius:12rpx; background:linear-gradient(145deg,#174f3d,#0a3028); box-shadow:0 24rpx 70rpx rgba(0,0,0,.55); }
.result-title,.ranking-title { color:#efd187; text-shadow:0 3rpx #6e231a; }

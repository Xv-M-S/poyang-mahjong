@import "../index/index.wxss";.room-page{min-height:100vh;padding:55rpx 34rpx;background:linear-gradient(150deg,#0d4d3a,#052c25);color:#fff}.room-top{text-align:center;color:rgba(255,255,255,.55);font-size:23rpx}.room-code{margin-top:8rpx;color:#f6d788;font-size:76rpx;font-weight:800;letter-spacing:14rpx}.room-hint{display:block;margin-top:8rpx;font-size:20rpx}.seat-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:55rpx}.seat-card{display:flex;flex-direction:column;align-items:center;padding:34rpx 18rpx;border:1rpx solid rgba(255,255,255,.1);border-radius:22rpx;background:rgba(255,255,255,.07)}.seat-card.empty{opacity:.45}.seat-avatar{width:80rpx;height:80rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#d8b65b;color:#173b31;font-size:30rpx;font-weight:800}.seat-name{margin-top:16rpx;font-size:24rpx}.seat-state{margin-top:8rpx;color:rgba(255,255,255,.45);font-size:20rpx}.seat-state.ready{color:#60dfa0}.room-actions{margin-top:48rpx}.room-actions button{margin-top:18rpx}.room-start{width:100%}.wait-owner,.connection-label{display:block;margin-top:28rpx;color:rgba(255,255,255,.45);font-size:22rpx;text-align:center}.leave-button{margin-top:28rpx!important;background:transparent!important;color:rgba(255,255,255,.65)!important;border:1rpx solid rgba(255,255,255,.22)!important}.leave-button::after{border:none}
/* classic-mahjong-theme */
.room-page {
  position:relative;
  background:
    radial-gradient(circle at 50% 15%,rgba(209,162,68,.16),transparent 27%),
    repeating-linear-gradient(45deg,rgba(255,255,255,.014) 0 2rpx,transparent 2rpx 14rpx),
    linear-gradient(155deg,#124b39,#082c25 58%,#061e1a);
  box-shadow:inset 0 0 120rpx rgba(0,0,0,.34);
}
.room-page::before {
  content:"";
  position:absolute;
  top:34rpx;
  left:32rpx;
  right:32rpx;
  height:7rpx;
  border:1rpx solid rgba(226,184,88,.5);
  border-left-width:8rpx;
  border-right-width:8rpx;
}
.room-top { color:#b9aa89; }
.room-code {
  color:#f0d184;
  font-family:Georgia,"Times New Roman",serif;
  text-shadow:0 4rpx #6d251b,0 9rpx 20rpx rgba(0,0,0,.35);
}
.room-hint { color:#958a70; }
.seat-grid { gap:22rpx; }
.seat-card {
  position:relative;
  border:6rpx double #9a6635;
  border-radius:10rpx;
  background:linear-gradient(145deg,rgba(28,82,64,.96),rgba(7,43,35,.96));
  box-shadow:inset 0 0 30rpx rgba(0,0,0,.22),0 12rpx 24rpx rgba(0,0,0,.3);
}
.seat-card.empty { opacity:.58; border-style:dashed; }
.seat-avatar {
  border:3rpx solid #eed087;
  border-radius:8rpx;
  background:linear-gradient(145deg,#f2da98,#ae7934);
  color:#6b211a;
  text-shadow:0 1rpx rgba(255,255,255,.5);
  box-shadow:0 7rpx 0 #5d351d,0 12rpx 18rpx rgba(0,0,0,.3);
}
.seat-name { color:#f4e9cd; }
.seat-state.ready { color:#efca69; }
.room-actions .secondary-button,
.room-start,
.leave-button { border-radius:8rpx!important; }
.room-start { border:2rpx solid #efd087; }
.leave-button { color:#b9ab8c!important; border-color:rgba(202,174,112,.32)!important; }
.connection-label { color:#8f856f; letter-spacing:2rpx; }

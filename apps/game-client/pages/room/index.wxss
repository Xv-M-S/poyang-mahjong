@import "../index/index.wxss";.room-page{min-height:100vh;padding:55rpx 34rpx;background:linear-gradient(150deg,#0d4d3a,#052c25);color:#fff}.room-top{text-align:center;color:rgba(255,255,255,.55);font-size:23rpx}.room-code{margin-top:8rpx;color:#f6d788;font-size:76rpx;font-weight:800;letter-spacing:14rpx}.room-hint{display:block;margin-top:8rpx;font-size:20rpx}.seat-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:55rpx}.seat-card{display:flex;flex-direction:column;align-items:center;padding:34rpx 18rpx;border:1rpx solid rgba(255,255,255,.1);border-radius:22rpx;background:rgba(255,255,255,.07)}.seat-card.empty{opacity:.45}.seat-avatar{width:80rpx;height:80rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#d8b65b;color:#173b31;font-size:30rpx;font-weight:800}.seat-name{margin-top:16rpx;font-size:24rpx}.seat-state{margin-top:8rpx;color:rgba(255,255,255,.45);font-size:20rpx}.seat-state.ready{color:#60dfa0}.room-actions{margin-top:48rpx}.room-actions button{margin-top:18rpx}.room-start{width:100%}.wait-owner,.connection-label{display:block;margin-top:28rpx;color:rgba(255,255,255,.45);font-size:22rpx;text-align:center}
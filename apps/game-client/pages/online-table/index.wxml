<view class="table-page"><view class="table-header"><view><text class="round-label">联网房间 {{roomCode}}</text><text class="wall-label">牌墙 {{wallCount}} 张 · {{connectionState}}</text></view><view class="score-strip"><view wx:for="{{scores}}" wx:key="seat" class="score-chip {{item.dealer?'dealer':''}}"><text>{{item.name}}</text><text class="score-value">{{item.score}}</text></view></view></view><view class="mahjong-table"><view wx:for="{{opponents}}" wx:key="seat" class="opponent opponent-{{item.position}} {{item.active?'active':''}}"><view class="avatar">{{item.initial}}</view><view class="opponent-meta"><text>{{item.name}}</text><text class="tile-count">{{item.count}} 张 · {{item.meldCount}} 组</text></view></view><view class="center-panel"><view class="wind-disc"><text class="wind-main">联</text><text class="wind-sub">{{currentName}}行动</text></view><text class="turn-message">{{message}}</text></view><view class="discard-area discard-top"><view wx:for="{{discards[2]}}" wx:key="id" class="discard-tile suit-{{item.suitClass}}"><text>{{item.symbol}}</text><text class="discard-unit">{{item.unit}}</text></view></view><view class="discard-area discard-left"><view wx:for="{{discards[3]}}" wx:key="id" class="discard-tile suit-{{item.suitClass}}"><text>{{item.symbol}}</text><text class="discard-unit">{{item.unit}}</text></view></view><view class="discard-area discard-right"><view wx:for="{{discards[1]}}" wx:key="id" class="discard-tile suit-{{item.suitClass}}"><text>{{item.symbol}}</text><text class="discard-unit">{{item.unit}}</text></view></view><view class="discard-area discard-bottom"><view wx:for="{{discards[0]}}" wx:key="id" class="discard-tile suit-{{item.suitClass}}"><text>{{item.symbol}}</text><text class="discard-unit">{{item.unit}}</text></view></view></view><view class="player-panel {{currentSeat===mySeat?'my-turn':''}}"><scroll-view wx:if="{{playerMelds.length}}" class="meld-scroll" scroll-x><view class="meld-row"><view wx:for="{{playerMelds}}" wx:key="index" class="meld-group"><text class="meld-label">{{item.label}}</text><view class="meld-tiles"><view wx:for="{{item.tiles}}" wx:for-item="meldTile" wx:key="id" class="meld-tile suit-{{meldTile.suitClass}}"><text>{{meldTile.symbol}}</text><text class="meld-unit">{{meldTile.unit}}</text></view></view></view></view></scroll-view><view wx:if="{{availableActions.length}}" class="action-bar"><button wx:for="{{availableActions}}" wx:key="key" data-key="{{item.key}}" class="action-button action-{{item.actionClass}}" bindtap="chooseAction">{{item.label}}</button></view><view class="player-status"><text>{{message}}</text><button class="discard-button" disabled="{{!canDiscard||selectedId===null}}" bindtap="discardSelected">出牌</button></view><scroll-view class="hand-scroll" scroll-x enhanced><view class="hand-row"><view wx:for="{{hand}}" wx:key="id" data-id="{{item.id}}" bindtap="selectTile" class="mahjong-tile suit-{{item.suitClass}} {{item.selected?'selected':''}}"><text class="tile-symbol">{{item.symbol}}</text><text class="tile-unit">{{item.unit}}</text></view></view></scroll-view></view><view wx:if="{{showSettlement}}" class="result-mask"><view class="result-card"><text class="result-title">{{matchCompleted?'比赛结束':'本局结束'}}</text><text class="result-message">服务器已完成权威结算</text><button wx:if="{{!matchCompleted&&isOwner}}" class="primary-button compact" bindtap="startNextRound">下一局</button><text wx:elif="{{!matchCompleted}}" class="wait-owner">等待房主开始下一局</text><button wx:else class="primary-button compact" bindtap="backToRoom">返回房间</button></view></view></view>
<import src="../../templates/tile-face.wxml" />
<view class="table-page"><view class="table-header"><view><text class="round-label">联网房间 {{roomCode}}</text><text class="wall-label">牌墙 {{wallCount}} 张 · {{connectionState}}</text></view><view class="score-strip"><view wx:for="{{scores}}" wx:key="seat" class="score-chip {{item.dealer?'dealer':''}}"><text>{{item.name}}</text><text class="score-value">{{item.score}}</text></view></view></view><view class="mahjong-table"><view wx:for="{{opponents}}" wx:key="seat" class="opponent opponent-{{item.position}} {{item.active?'active':''}}"><view class="avatar">{{item.initial}}</view><view class="opponent-meta"><text>{{item.name}}</text><text class="tile-count">{{item.count}} 张 · {{item.meldCount}} 组</text></view></view><view class="center-panel"><view class="wind-disc"><text class="wind-main">联</text><text class="wind-sub">{{currentName}}行动</text></view><text class="turn-message">{{message}}</text><text wx:if="{{countdown>0}}" class="turn-countdown">{{countdown}}s</text></view><view class="discard-area discard-top"><view wx:for="{{discards[2]}}" wx:key="id" class="discard-tile suit-{{item.suitClass}}"><template is="tile-face" data="{{...item}}" /></view></view><view class="discard-area discard-left"><view wx:for="{{discards[3]}}" wx:key="id" class="discard-tile suit-{{item.suitClass}}"><template is="tile-face" data="{{...item}}" /></view></view><view class="discard-area discard-right"><view wx:for="{{discards[1]}}" wx:key="id" class="discard-tile suit-{{item.suitClass}}"><template is="tile-face" data="{{...item}}" /></view></view><view class="discard-area discard-bottom"><view wx:for="{{discards[0]}}" wx:key="id" class="discard-tile suit-{{item.suitClass}}"><template is="tile-face" data="{{...item}}" /></view></view></view><view class="player-panel {{currentSeat===mySeat?'my-turn':''}}"><scroll-view wx:if="{{playerMelds.length}}" class="meld-scroll" scroll-x><view class="meld-row"><view wx:for="{{playerMelds}}" wx:key="index" class="meld-group"><text class="meld-label">{{item.label}}</text><view class="meld-tiles"><view wx:for="{{item.tiles}}" wx:for-item="meldTile" wx:key="id" class="meld-tile suit-{{meldTile.suitClass}}"><template is="tile-face" data="{{...meldTile}}" /></view></view></view></view></scroll-view><view wx:if="{{availableActions.length}}" class="action-bar"><button wx:for="{{availableActions}}" wx:key="key" data-key="{{item.key}}" class="action-button action-{{item.actionClass}}" bindtap="chooseAction">{{item.label}}</button></view><view class="player-status"><text>{{message}}</text><button class="discard-button" disabled="{{!canDiscard||selectedId===null}}" bindtap="discardSelected">出牌</button></view><scroll-view class="hand-scroll" scroll-x enhanced><view class="hand-row"><view wx:for="{{hand}}" wx:key="id" data-id="{{item.id}}" bindtap="selectTile" class="mahjong-tile suit-{{item.suitClass}} {{item.selected?'selected':''}}"><template is="tile-face" data="{{...item}}" /></view></view></scroll-view></view><view wx:if="{{showSettlement}}" class="result-mask">
  <view class="result-card">
    <text class="result-title">{{matchCompleted?'比赛结束':'本局结束'}}</text>
    <text class="result-message">{{settlementReason}}</text>
    <view class="network-settlement">
      <view wx:for="{{settlementRows}}" wx:key="seat" class="settlement-row">
        <text>{{item.name}}</text>
        <text class="{{item.delta>=0?'score-positive':'score-negative'}}">{{item.delta>=0?'+':''}}{{item.delta}}</text>
        <text>累计 {{item.score}}</text>
      </view>
    </view>
    <button wx:if="{{!matchCompleted&&isOwner}}" class="primary-button compact" bindtap="startNextRound">下一局</button>
    <text wx:elif="{{!matchCompleted}}" class="wait-owner">等待房主开始下一局</text>
    <button wx:if="{{matchCompleted&&isOwner}}" class="primary-button compact" bindtap="restartMatch">再来一场</button>
    <text wx:elif="{{matchCompleted}}" class="wait-owner">等待房主发起下一场</text>
    <button class="leave-match-button" bindtap="leaveMatch">{{isOwner?'解散房间':'退出房间'}}</button>
  </view>
</view>
</view>